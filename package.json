{
  "name": "paulplonski-site",
  "version": "1.0.0",
  "private": true,
  "description": "Source for paulplonski.com, built with Eleventy and served by Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "clean": "node -e \"require('node:fs').rmSync('_site',{recursive:true,force:true})\"",
    "build": "npm run clean && eleventy",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@fontsource-variable/noto-sans": "5.3.0",
    "js-yaml": "5.4.2",
    "wrangler": "4.136.3"
  }
}
